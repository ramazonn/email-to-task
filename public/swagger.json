  "info": {
    "title": "Email-to-Task API",
    "description": "API for ingesting emails and managing tenant-scoped tasks.\n\n**Authorize once (top right):**\n1. `basicAuth` — WEBHOOK_BASIC_AUTH_USER / WEBHOOK_BASIC_AUTH_PASS (webhook, companies, users)\n2. `tenantCompanyApiKey` — company apiKey from seed (`company-1-api-key-test` for Company 1)",
    "version": "1.0.0",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "basicAuth": {
        "type": "http",
        "scheme": "basic",
        "description": "Admin/webhook basic auth (WEBHOOK_BASIC_AUTH_USER/PASS)"
      },
      "tenantCompanyApiKey": {
        "type": "apiKey",
        "in": "header",
        "name": "x-company-api-key",
        "description": "Tenant company API key (e.g. company-1-api-key-test after seed)"
      }
    },
    "schemas": {
      "InboundEmailDto": {
        "type": "object",
        "properties": {
          "providerMessageId": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "subject": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "html": {
            "type": "string"
          },
          "receivedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "providerMessageId",
          "from",
          "to",
          "text"
        ]
      },
      "CreateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Corp"
          },
          "apiKey": {
            "type": "string",
            "description": "API key for the company. Auto-generated when omitted.",
            "example": "cmp_live_abc123"
          }
        },
        "required": [
          "name"
        ]
      },
      "UpdateCompanyDto": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "example": "Acme Corporation"
          },
          "apiKey": {
            "type": "string",
            "example": "cmp_live_new_key"
          }
        },
        "required": [
          "name",
          "apiKey"
        ]
      },
      "CreateUserDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "example": "665f1b2c3d4e5f6a7b8c9d0e"
          },
          "name": {
            "type": "string",
            "example": "Alice Smith"
          },
          "emails": {
            "example": [
              "alice@acme.example"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "companyId",
          "name",
          "emails"
        ]
      },
      "UpdateUserDto": {
        "type": "object",
        "properties": {
          "companyId": {
            "type": "string",
            "example": "665f1b2c3d4e5f6a7b8c9d0e"
          },
          "name": {
            "type": "string",
            "example": "Alice Smith"
          },
          "emails": {
            "example": [
              "alice@acme.example"
            ],
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "companyId",
          "name",
          "emails"
        ]
      },
      "ReviewTaskDto": {
        "type": "object",
        "properties": {
          "decision": {
            "type": "string",
            "enum": [
              "accept",
              "reject"
            ]
          }
        },
        "required": [
          "decision"
        ]
      }
    }
  }
}